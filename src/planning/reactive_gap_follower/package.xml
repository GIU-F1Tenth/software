<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>reactive_gap_follower</name>
  <version>0.1.0</version>
  <description>Disparity-extender reactive gap follower for F1TENTH. Pure /scan input, no localization.</description>
  <maintainer email="karim.shousha.ks@gmail.com">Karim Shousha</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <buildtool_depend>setuptools</buildtool_depend>

  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
